# Instellingen voor lokaal testen. Zie README.md voor de MariaDB-stappen.
APP_ENV=local
APP_URL=http://127.0.0.1:8080
APP_TIMEZONE=Europe/Amsterdam

# Deze gegevens horen bij de SQL-commando's in README.md.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=application_portal
DB_USERNAME=portal
DB_PASSWORD=portal_lokaal_2026

# false is nodig voor de lokale website via http://.
SESSION_SECURE=false

# Genereer een sleutel met: php scripts/generate-key.php
# Plak de volledige uitvoer (inclusief base64:) achter APP_KEY=.
APP_KEY=

# Lokale Mailpit-inbox; alleen nodig wanneer je e-mailflows test.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_ENCRYPTION=none
SMTP_USERNAME=
SMTP_PASSWORD=
RETENTION_DAYS=28
